PORT=3000
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-luna
# Only honored by reasoning-capable models (o1/o3/o4-mini, reasoning-enabled gpt-5.x): minimal | low | medium | high
REASONING_EFFORT=HIGH
MAX_CONCURRENT_PLEAS=5
OPENAI_TIMEOUT_MS=30000
FRONTEND_ORIGIN=*
KEEPITHE_DO_NOT_CHANGE=https://your-username.github.io
